{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npm ci --no-audit --no-fund",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist/frontend",
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
